# ──────────────────────────────────────────────────────────────
# Realest — Backend (Express on Railway) environment variables
# Copy to `.env` and fill in. Never commit the real .env.
# ──────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000

# Neon Postgres — use the POOLED connection string from the Neon dashboard.
# It looks like: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# JWT signing secret. Generate one with: openssl rand -hex 32
JWT_SECRET=

# The Vercel frontend origin. Comma-separate to allow more than one
# (e.g. preview + production + localhost).
FRONTEND_URL=http://localhost:3000

# This API's own public URL (used to build the email verification link).
# Locally this is http://localhost:4000; in prod it's your Railway URL.
BACKEND_URL=http://localhost:4000

# Resend — leave RESEND_API_KEY empty in dev to print verification links
# to the server console instead of sending real email.
RESEND_API_KEY=
# Use Resend's shared sender until you've verified your own domain:
EMAIL_FROM=Realest <onboarding@resend.dev>

# Cookie name for the JWT (optional)
COOKIE_NAME=realest_token
