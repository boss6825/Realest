# ──────────────────────────────────────────────────────────────
# Realest — Frontend (Next.js on Vercel) environment variables
# Copy to `.env.local` for local dev. NEXT_PUBLIC_* vars are exposed
# to the browser, so never put secrets here.
# ──────────────────────────────────────────────────────────────

# The Railway backend base URL (no trailing slash).
# Local dev:  http://localhost:4000
# Production: https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000
