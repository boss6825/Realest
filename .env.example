# ════════════════════════════════════════════════════════════════════
# Realest — Dealer-to-Dealer Property Network
# ALL environment variables, in one place.
#
# This monorepo has two deployables, each reading its own env file:
#   • backend/  → copy the BACKEND block into  backend/.env
#   • frontend/ → copy the FRONTEND block into frontend/.env.local
#
# (Per-folder .env.example files also exist.) Never commit real secrets.
# ════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
# BACKEND  →  backend/.env   (Express on Railway)
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# Neon Postgres — use the POOLED connection string from the Neon dashboard.
# Format: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# JWT signing secret. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Vercel frontend origin(s). Comma-separate to allow several
# (e.g. "https://realest.vercel.app,http://localhost:3000").
# This is the exact origin CORS allows + the cookie is scoped to.
FRONTEND_URL=http://localhost:3000

# This API's own public URL — used to build the email verification link.
# Local: http://localhost:4000   Production: https://your-api.up.railway.app
BACKEND_URL=http://localhost:4000

# Resend (email verification). Leave RESEND_API_KEY empty in dev to print the
# verification link to the server console instead of sending real email.
RESEND_API_KEY=
# Use Resend's shared sender until your own domain is verified:
EMAIL_FROM=Realest <onboarding@resend.dev>

# Name of the JWT cookie (optional).
COOKIE_NAME=realest_token


# ─────────────────────────────────────────────────────────────
# FRONTEND  →  frontend/.env.local   (Next.js on Vercel)
# ─────────────────────────────────────────────────────────────

# Backend base URL (no trailing slash). NEXT_PUBLIC_* is sent to the browser,
# so keep secrets out of it.
# Local: http://localhost:4000   Production: https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000
